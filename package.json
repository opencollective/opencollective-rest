{
  "name": "opencollective-rest",
  "version": "2.2.0",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/opencollective/opencollective-rest.git"
  },
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "@apollo/client": "4.3.3",
    "@babel/core": "8.0.7",
    "@babel/plugin-transform-typescript": "8.0.6",
    "@babel/preset-env": "8.0.7",
    "@hyperwatch/hyperwatch": "5.3.1",
    "@json2csv/plainjs": "7.0.8",
    "babel-plugin-add-module-exports": "1.0.4",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "debug": "4.4.3",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "express-basic-auth": "1.2.1",
    "express-winston": "4.2.0",
    "graphql": "16.14.2",
    "graphql-request": "7.4.0",
    "graphql-tag": "2.12.7",
    "lodash": "4.18.1",
    "moment": "2.31.0",
    "node-fetch": "2.7.0",
    "omit-deep-lodash": "1.1.7",
    "rxjs": "7.8.2",
    "winston": "3.19.0"
  },
  "scripts": {
    "build:clean": "rm -rf dist && mkdir dist",
    "build:server": "babel ./src --copy-files --extensions .js,.ts -d ./dist",
    "build:updates": "babel-node --extensions .ts scripts/update-cloudflare-ips.ts dist/server/cloudflare-ips.json",
    "build": "npm run turbo -- run build:finalize",
    "depcheck": "npm run turbo -- run depcheck:task --",
    "deploy:production": "./scripts/pre-deploy.sh production && git push production main",
    "deploy:staging": "./scripts/pre-deploy.sh staging && git push -f staging main",
    "dev": "npm run turbo -- run dev:task --",
    "git:clean": "./scripts/git_clean.sh",
    "graphql:update:local": "cp ../frontend/lib/graphql/*.graphql src/graphql/ && prettier src/graphql/*.graphql --write",
    "graphql:update": "npm run turbo -- run graphql:refresh",
    "graphql:updateV1": "curl https://raw.githubusercontent.com/opencollective/opencollective-frontend/main/lib/graphql/schema.graphql --output src/graphql/schema.graphql && prettier src/graphql/schema.graphql --write",
    "graphql:updateV2": "curl https://raw.githubusercontent.com/opencollective/opencollective-frontend/main/lib/graphql/schemaV2.graphql --output src/graphql/schemaV2.graphql && prettier src/graphql/schemaV2.graphql --write",
    "lint-staged": "lint-staged",
    "lint:fix": "npm run turbo -- run lint:fix:task --",
    "lint:quiet": "npm run turbo -- run lint:quiet:task --",
    "lint": "npm run turbo -- run lint:task --",
    "prepare": "husky",
    "prettier:check": "npm run turbo -- run prettier:check:task --",
    "prettier:write": "npm run turbo -- run prettier:write:task --",
    "prettier": "npm run turbo -- run prettier:task --",
    "start": "TZ=UTC node dist/server",
    "test": "npm run turbo -- run test:task --",
    "test:watch": "npm run turbo -- run test:watch:task --",
    "test:server": "npm run turbo -- run test:server:task --",
    "test:server:coverage": "npm run turbo -- run test:server:coverage:task --",
    "type:check": "npm run turbo -- run type:check:task --",
    "format:check": "npm run turbo -- run format:check:task --",
    "format": "npm run turbo -- run format:task --",
    "build:compile": "npm run build:server",
    "build:finalize": "npm run build:updates",
    "graphql:refresh": "node -e \"\"",
    "graphql:sync:local": "node scripts/sync-local-schemas.cjs",
    "dev:environment": "npm run dev:task -- \"$OC_DEV_ENV_REST\"",
    "turbo": "turbo --skip-infer --single-package --root-turbo-json=turbo.standalone.json",
    "graphql:sync:after-frontend": "npm run graphql:sync:local",
    "depcheck:task": "npx @opencollective/depcheck .",
    "dev:task": "nodemon src/server/index.ts -x \"babel-node --extensions .js,.ts\" . -e js,ts --ignore 'test/'",
    "lint:fix:task": "npm run lint:task -- --fix",
    "lint:quiet:task": "npm run lint:task -- --quiet",
    "lint:task": "eslint .",
    "prettier:check:task": "npm run prettier:task -- --list-different",
    "prettier:write:task": "npm run prettier:task -- --write",
    "prettier:task": "prettier \"**/*.@(js|ts|json|md)\"",
    "test:task": "TZ=UTC jest",
    "test:watch:task": "TZ=UTC jest --watch",
    "test:server:task": "TZ=UTC ./scripts/run_test.sh",
    "test:server:coverage:task": "TZ=UTC ./scripts/run_test.sh --coverage --reporters=default --reporters=jest-junit",
    "type:check:task": "tsc",
    "format:check:task": "npm run prettier:check:task",
    "format:task": "npm run prettier:write:task"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.0",
    "@babel/node": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@graphql-eslint/eslint-plugin": "^4.4.1",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.23",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-config-opencollective": "^7.1.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-n": "^18.4.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-junit": "^17.0.0",
    "jsonwebtoken": "^9.0.3",
    "light-my-request": "^6.6.0",
    "lint-staged": "^17.0.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "turbo": "2.11.7"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "opencollective-api/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.*/)?(micro-strptime|syslog-parse|dnsbl|ip-cidr|chalk|cookie)/)"
    ],
    "transform": {
      "/node_modules/(micro-strptime|syslog-parse|dnsbl|ip-cidr|chalk|cookie)/.+\\.js$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": true
                }
              }
            ]
          ]
        }
      ],
      "\\.[jt]sx?$": "babel-jest"
    }
  },
  "lint-staged": {
    "*.{js,json,md,graphql}": [
      "prettier --write"
    ]
  },
  "cacheDirectories": [
    "node_modules"
  ],
  "@opencollective/depcheck": {
    "ignoreDirs": [
      "dist"
    ],
    "specials": [
      "babel",
      "bin",
      "eslint",
      "husky",
      "lint-staged",
      "typescript",
      "jest"
    ],
    "ignores": [
      "jest",
      "jest-junit",
      "typescript",
      "@babel/node",
      "@typescript-eslint/parser",
      "@graphql-eslint/eslint-plugin",
      "eslint-import-resolver-typescript",
      "turbo"
    ]
  },
  "heroku-run-build-script": true,
  "packageManager": "npm@11.19.0"
}
