{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build:clean": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "build:server": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "build:updates": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "build": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "depcheck": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "dev": {
      "cache": false,
      "passThroughEnv": ["*"],
      "persistent": true
    },
    "graphql:update": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "graphql:updateV1": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "graphql:updateV2": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "lint-staged": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "lint:fix": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "lint:quiet": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "package-lock.json",
        ".env*",
        "!dist/**",
        "!.next/**",
        "!coverage/**",
        "!.nyc_output/**",
        "!.turbo/**",
        "!*.tsbuildinfo",
        "!test-results.xml",
        "!test-report.junit.xml",
        "!junit.xml",
        "!.eslintcache",
        "!.prettiercache",
        "!_sidebar.md"
      ],
      "env": ["CI", "NODE_ENV", "OC_ENV", "TZ", "NODE_OPTIONS", "OC_LOCKFILE_HASH_REST"],
      "outputs": [],
      "cache": true
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "package-lock.json",
        ".env*",
        "!dist/**",
        "!.next/**",
        "!coverage/**",
        "!.nyc_output/**",
        "!.turbo/**",
        "!*.tsbuildinfo",
        "!test-results.xml",
        "!test-report.junit.xml",
        "!junit.xml",
        "!.eslintcache",
        "!.prettiercache",
        "!_sidebar.md"
      ],
      "env": ["CI", "NODE_ENV", "OC_ENV", "TZ", "NODE_OPTIONS", "OC_LOCKFILE_HASH_REST"],
      "outputs": [],
      "cache": true
    },
    "prettier:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "package-lock.json",
        ".env*",
        "!dist/**",
        "!.next/**",
        "!coverage/**",
        "!.nyc_output/**",
        "!.turbo/**",
        "!*.tsbuildinfo",
        "!test-results.xml",
        "!test-report.junit.xml",
        "!junit.xml",
        "!.eslintcache",
        "!.prettiercache",
        "!_sidebar.md"
      ],
      "env": ["CI", "NODE_ENV", "OC_ENV", "TZ", "NODE_OPTIONS", "OC_LOCKFILE_HASH_REST"],
      "outputs": [],
      "cache": true
    },
    "start": {
      "cache": false,
      "passThroughEnv": ["*"],
      "persistent": true,
      "dependsOn": ["build:finalize"]
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "test:watch": {
      "cache": false,
      "passThroughEnv": ["*"],
      "persistent": true
    },
    "test:server": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "test:server:coverage": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "type:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "package-lock.json",
        ".env*",
        "!dist/**",
        "!.next/**",
        "!coverage/**",
        "!.nyc_output/**",
        "!.turbo/**",
        "!*.tsbuildinfo",
        "!test-results.xml",
        "!test-report.junit.xml",
        "!junit.xml",
        "!.eslintcache",
        "!.prettiercache",
        "!_sidebar.md"
      ],
      "env": ["CI", "NODE_ENV", "OC_ENV", "TZ", "NODE_OPTIONS", "OC_LOCKFILE_HASH_REST"],
      "outputs": [],
      "cache": true
    },
    "format:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "package-lock.json",
        ".env*",
        "!dist/**",
        "!.next/**",
        "!coverage/**",
        "!.nyc_output/**",
        "!.turbo/**",
        "!*.tsbuildinfo",
        "!test-results.xml",
        "!test-report.junit.xml",
        "!junit.xml",
        "!.eslintcache",
        "!.prettiercache",
        "!_sidebar.md"
      ],
      "env": ["CI", "NODE_ENV", "OC_ENV", "TZ", "NODE_OPTIONS", "OC_LOCKFILE_HASH_REST"],
      "outputs": [],
      "cache": true
    },
    "format": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "build:compile": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "package-lock.json",
        ".env*",
        "!dist/**",
        "!.next/**",
        "!coverage/**",
        "!.nyc_output/**",
        "!.turbo/**",
        "!*.tsbuildinfo",
        "!test-results.xml",
        "!test-report.junit.xml",
        "!junit.xml",
        "!.eslintcache",
        "!.prettiercache",
        "!_sidebar.md"
      ],
      "env": ["CI", "NODE_ENV", "OC_ENV", "TZ", "NODE_OPTIONS", "BABEL_ENV", "OC_LOCKFILE_HASH_REST"],
      "outputs": ["dist/**", "!dist/.next/cache/**", "!dist/.next/dev/**"],
      "cache": true,
      "dependsOn": ["build:clean"]
    },
    "build:finalize": {
      "cache": false,
      "passThroughEnv": ["*"],
      "dependsOn": ["build:compile"]
    },
    "graphql:refresh": {
      "cache": false,
      "passThroughEnv": ["*"],
      "dependsOn": ["graphql:updateV1", "graphql:updateV2"]
    },
    "dev:environment": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "graphql:sync:local": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "graphql:sync:after-frontend": {
      "cache": false,
      "passThroughEnv": ["*"],
      "dependsOn": ["opencollective-frontend#graphql:refresh"]
    }
  }
}
